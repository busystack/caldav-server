worker_processes 1;
error_log /dev/null crit;
pid /tmp/nginx.pid;
events { worker_connections 128; }
http {
    gzip off;
    log_format safe '$request_id $request_method $status $request_time';
    access_log /dev/stdout safe;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    server_tokens off;
    server {
        listen 8443 ssl;
        server_name @@HOSTNAME@@;
        ssl_certificate /tls/server.pem;
        ssl_certificate_key /tls/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header X-Request-ID $request_id always;
        location = @@PREFIX@@ { return 308 @@ORIGIN@@@@PREFIX@@/; }
        location = /.well-known/caldav { return 308 @@ORIGIN@@@@PREFIX@@/dav/; }
        location = /.well-known/oauth-authorization-server@@PREFIX@@ {
            proxy_pass http://application:8080@@PREFIX@@/.well-known/oauth-authorization-server;
            proxy_set_header Host @@AUTHORITY@@;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header X-Request-ID $request_id;
        }
        location = @@PREFIX@@/actuator { return 404; }
        location ^~ @@PREFIX@@/actuator/ { return 404; }
        location = /actuator { return 404; }
        location ^~ /actuator/ { return 404; }
        location @@PREFIX@@/ {
            proxy_http_version 1.1;
            proxy_connect_timeout 5s;
            proxy_read_timeout 30s;
            proxy_pass http://application:8080;
            proxy_set_header Host @@AUTHORITY@@;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header X-Request-ID $request_id;
        }
        location / { return 404; }
    }
}
