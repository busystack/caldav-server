* text=auto eol=lf
mvnw.cmd text eol=crlf
# Preserve auditable upstream sources and their exact unified diffs.
src/main/java/org/busystack/caldav/calendar/parser/Ical4jCalendarParser.java whitespace=-blank-at-eol
docs/ical4j-4.4.0-parser.patch -whitespace
src/main/java/org/busystack/caldav/calendar/timezone/Ical4jZoneRulesBuilder.java whitespace=-blank-at-eol
docs/ical4j-4.4.0-timezone.patch -whitespace

# Calendar fixtures retain the accepted/client-emitted representation byte for byte.
src/test/resources/calendar/**/*.ics -text whitespace=cr-at-eol
src/test/resources/calendar/*.ics -text whitespace=cr-at-eol

# Preserve recorded protocol output and its evidence checksums exactly.
qualification/evidence/standards-corrections/**/*.log -text whitespace=cr-at-eol

# Deliver upstream license texts verbatim, including their original trailing whitespace.
licenses/EPL-2.0.txt -text -whitespace
licenses/LGPL-2.1.txt -text
licenses/logback-LICENSE.txt -text -whitespace
licenses/asm-9.7.1-copyright-and-license.txt -text

# Retain original release-verification client wire bytes.
qualification/evidence/releases/**/*.ics -text whitespace=cr-at-eol
