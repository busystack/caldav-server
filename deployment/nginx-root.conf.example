server {
    listen 443 ssl;
    server_name calendar.example.org; # OPERATOR: replace domain and supply DNS
    ssl_certificate /etc/ssl/caldav/fullchain.pem; # OPERATOR: trusted chain
    ssl_certificate_key /etc/ssl/caldav/privkey.pem; # OPERATOR: protect private key
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    gzip off;
    client_max_body_size 1m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_set_header Host calendar.example.org;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    location = /portability { proxy_pass http://127.0.0.1:8080; }
    location = /portability/preview { client_max_body_size 65m; proxy_http_version 1.1; proxy_request_buffering off; proxy_buffering off; proxy_read_timeout 660s; proxy_pass http://127.0.0.1:8080; }
    location ^~ /portability/ { proxy_http_version 1.1; proxy_request_buffering off; proxy_buffering off; proxy_read_timeout 660s; proxy_pass http://127.0.0.1:8080; }
    location = /actuator { return 404; }
    location ^~ /actuator/ { return 404; }
    location / { proxy_pass http://127.0.0.1:8080; }
}
