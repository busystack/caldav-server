# Supply your real HTTPS hostname and operator-managed certificate.
BUSYSTACK_PUBLIC_BASE_URL=https://calendar.example.org
BUSYSTACK_ISSUER=https://calendar.example.org
BUSYSTACK_DATABASE_PASSWORD_FILE=/absolute/private/path/database-password
BUSYSTACK_POSTGRES_ADMIN_PASSWORD_FILE=/absolute/private/path/postgres-admin-password
BUSYSTACK_HTTP_PORT=8080
# Set COMPOSE_PROJECT_NAME to an isolated name when exercising a trial/restore.
